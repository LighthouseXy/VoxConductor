# 阿里云百炼：ASR 和实时 TTS 共用该密钥
DASHSCOPE_API_KEY=replace-with-your-key

# 千问 ASR 的 OpenAI 兼容接口根地址；按所在地域和百炼工作空间填写
DASHSCOPE_BASE_URL=https://YOUR_DASHSCOPE_ENDPOINT/compatible-mode/v1
ASR_MODEL=qwen3-asr-flash

# 千问 TTS 配置
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry

# DeepSeek 文本生成
DEEPSEEK_API_KEY=replace-with-your-key

# 天气位置。示例为杭州，请按实际部署位置修改
WEATHER_LATITUDE=30.2741
WEATHER_LONGITUDE=120.1551
WEATHER_TIMEZONE=Asia/Shanghai
WEATHER_CITY=杭州
